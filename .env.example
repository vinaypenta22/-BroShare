# Docker Compose. Replace both secret values before startup.
POSTGRES_PASSWORD=replace_with_a_url_safe_password
SECRET_KEY=replace_with_a_long_random_django_secret
DEBUG=false
DEMO_ENABLED=false
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false
# Public deployment requires HTTPS and its permitted hostname / origin.
# TRUST_HTTPS_PROXY=true
# CSRF_TRUSTED_ORIGINS=https://broshare.example
# SECURE_HSTS_SECONDS=31536000
